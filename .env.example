# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database (SQLite for lightweight; swap to postgres:// for production)
DATABASE_URL=sqlite:///otp_service.db

# SMS Magic API
SMS_MAGIC_API_URL=https://api.sms-magic.com
SMS_MAGIC_ACCESS_KEY=your-access-key
SMS_MAGIC_SECRET_KEY=your-secret-key
SMS_MAGIC_SENDER_ID=your-sender-id

# Email (SMTP) Channel
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# WhatsApp Channel (via SMS Magic or Twilio)
WHATSAPP_PROVIDER=sms_magic   # or: twilio
WHATSAPP_FROM=+1234567890

# OTP Configuration
OTP_LENGTH=6
OTP_VALIDITY_SECONDS=300       # 5 minutes
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Webhook / Callback
INCOMING_WEBHOOK_TOKEN=your-webhook-secret-token

# Rate limiting
RATELIMIT_STORAGE_URL=memory://
